# RabbitMQ Configuration
# Recommended: Use RABBITMQ_URL for connection (supports all cloud providers)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Alternative: Individual parameters (legacy support)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/

# ==============================================================================
# S3 Configuration - Dual-Bucket Mode (Recommended)
# ==============================================================================
# Separate buckets for voice storage and TTS output with independent configs
# This allows different providers, regions, credentials per bucket

# Storage Bucket (for voice recordings and audio prompts)
S3_STORAGE_ENDPOINT_URL=https://provider-a.storage.com/storage/v1/s3
S3_STORAGE_ACCESS_KEY_ID=storage-access-key
S3_STORAGE_SECRET_ACCESS_KEY=storage-secret-key
S3_STORAGE_BUCKET_NAME=voice-library
S3_STORAGE_REGION=ap-southeast-1
S3_STORAGE_USE_SSL=true

# Output Bucket (for TTS synthesis results)
S3_OUTPUT_ENDPOINT_URL=https://provider-b.storage.com/storage/v1/s3
S3_OUTPUT_ACCESS_KEY_ID=output-access-key
S3_OUTPUT_SECRET_ACCESS_KEY=output-secret-key
S3_OUTPUT_BUCKET_NAME=tts-output
S3_OUTPUT_REGION=us-east-1
S3_OUTPUT_USE_SSL=true

# ==============================================================================
# S3 Configuration - Legacy Single-Bucket Mode (Backwards Compatible)
# ==============================================================================
# Comment out the dual-bucket vars above and uncomment these for legacy mode
# S3_ENDPOINT_URL=https://storage.provider.com/storage/v1/s3
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=studio
# S3_REGION=ap-southeast-1
# S3_USE_SSL=true

# Worker Configuration
WORKER_LOG_LEVEL=INFO
