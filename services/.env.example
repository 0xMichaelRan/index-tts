# RabbitMQ Configuration
# Recommended: Use RABBITMQ_URL for connection (supports all cloud providers)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Alternative: Individual parameters (legacy support)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/

# S3 Configuration (Supabase Storage S3-compatible API)
# Required for audio file storage and retrieval
S3_ENDPOINT_URL=https://uhxdobvynuwpyzyfqccq.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-supabase-access-key
S3_SECRET_ACCESS_KEY=your-supabase-secret-key
S3_BUCKET_NAME=studio
S3_REGION=ap-southeast-1
S3_USE_SSL=true

# Worker Configuration
WORKER_LOG_LEVEL=INFO
