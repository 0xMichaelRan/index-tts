# ============================
# REQUIRED
# ============================
# Database (REQUIRED for ttsId generation & synthesis cache)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indextts
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# S3 credentials — bucket structure (names, regions) is defined in config/buckets.toml.
# Only sensitive credentials are provided via environment variables.
# Pattern: S3_<TYPE>_ENDPOINT_URL / S3_<TYPE>_ACCESS_KEY_ID / S3_<TYPE>_SECRET_ACCESS_KEY
# Supported types: misc, video, audio, tts, 11lab

# MISC bucket — general miscellaneous assets and temporary uploads
S3_MISC_ENDPOINT_URL=https://project.storage.example.com/s3
S3_MISC_ACCESS_KEY_ID=your-misc-access-key
S3_MISC_SECRET_ACCESS_KEY=your-misc-secret-key

# VIDEO bucket — video clips and rendered MP4 outputs
S3_VIDEO_ENDPOINT_URL=https://project.storage.example.com/s3
S3_VIDEO_ACCESS_KEY_ID=your-video-access-key
S3_VIDEO_SECRET_ACCESS_KEY=your-video-secret-key

# AUDIO bucket — user voice recordings and audio prompts for TTS voice cloning (read-only for worker)
S3_AUDIO_ENDPOINT_URL=https://project.storage.example.com/s3
S3_AUDIO_ACCESS_KEY_ID=your-audio-access-key
S3_AUDIO_SECRET_ACCESS_KEY=your-audio-secret-key

# TTS bucket — IndexTTS synthesised audio output and alignment JSON (worker writes here)
S3_TTS_ENDPOINT_URL=https://project.storage.example.com/s3
S3_TTS_ACCESS_KEY_ID=your-tts-access-key
S3_TTS_SECRET_ACCESS_KEY=your-tts-secret-key

# 11LAB bucket — user-uploaded ElevenLabs audio exports (frontend uploads; worker read-only)
S3_11LAB_ENDPOINT_URL=https://project.storage.example.com/s3
S3_11LAB_ACCESS_KEY_ID=your-11lab-access-key
S3_11LAB_SECRET_ACCESS_KEY=your-11lab-secret-key

# ============================
# OPTIONAL
# ============================

# Logging (LOG_LEVEL: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/worker.log

# Circuit breaker (opens after consecutive failures; reset timeout in seconds)
CIRCUIT_BREAKER_S3_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_S3_RESET_TIMEOUT=60
CIRCUIT_BREAKER_TTS_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TTS_RESET_TIMEOUT=30

# Synthesis cache (reuse audio for same text + voice)
TTS_CACHE_ENABLED=true
TTS_CACHE_MAX_ENTRIES=10000
TTS_CACHE_EVICTION_THRESHOLD=9000
TTS_CACHE_LOCAL_DIR=outputs/tts_cache

# Inference and loudness normalization (infer_fast on Windows/Linux; macOS uses infer)
TTS_USE_FAST_INFERENCE=true
TTS_NORMALIZATION_ENABLED=true
TTS_NORMALIZATION_TARGET_LUFS=-16.0

# ============================
# Forced Alignment (stable-whisper)
# ============================

# Whisper model name — "small" recommended (balance of accuracy vs CPU latency)
TTS_ALIGNMENT_MODEL=small

# Device for alignment — must be cpu; GPU is reserved for IndexTTS
# Do NOT set to "mps" on Apple Silicon (float64 crash; see STABLE_WHISPER_ALIGNMENT_PLAN.md §15)
TTS_ALIGNMENT_DEVICE=cpu

# Directory where Whisper model weights are cached (default: ~/.cache/whisper)
# Set to a persistent path in containerised deployments to avoid re-downloading on restart
# TTS_ALIGNMENT_MODEL_DIR=/opt/models/whisper

# Max alignment retries per job on transient failure
TTS_ALIGNMENT_MAX_RETRIES=2

# Alignment circuit breaker
CIRCUIT_BREAKER_ALIGNMENT_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_ALIGNMENT_RESET_TIMEOUT=60

# ============================
# Vox Render Consumer
# (Linux/Windows only — ignored on macOS)
# ============================

# Enable the vox_jobs consumer (set false to disable on this worker)
VOX_RENDER_ENABLED=true

# Path to ffmpeg binary (must be on PATH or provide absolute path)
VOX_RENDER_FFMPEG_PATH=ffmpeg
