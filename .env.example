# ============================
# REQUIRED
# ============================
# Database (REQUIRED for ttsId generation & synthesis cache)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indextts
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Storage bucket (voices, audio prompts — read during synthesis)
S3_MISC_ENDPOINT_URL=https://project.storage.supabase.co/storage/v1/s3
S3_MISC_ACCESS_KEY_ID=your-storage-access-key
S3_MISC_SECRET_ACCESS_KEY=your-storage-secret-key
S3_MISC_BUCKET_NAME=bucket-name
S3_MISC_REGION=auto
S3_MISC_USE_SSL=true

# Output bucket (TTS results — written after synthesis)
R2_VOICE_ENDPOINT_URL=https://project.storage.supabase.co/storage/v1/s3
R2_VOICE_ACCESS_KEY_ID=your-output-access-key
R2_VOICE_SECRET_ACCESS_KEY=your-output-secret-key
R2_VOICE_BUCKET_NAME=bucket-name
R2_VOICE_REGION=auto
R2_VOICE_USE_SSL=true

# ============================
# OPTIONAL
# ============================

# Logging (LOG_LEVEL: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/worker.log

# Circuit breaker (opens after consecutive failures; reset timeout in seconds)
CIRCUIT_BREAKER_S3_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_S3_RESET_TIMEOUT=60
CIRCUIT_BREAKER_TTS_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TTS_RESET_TIMEOUT=30

# Synthesis cache (reuse audio for same text + voice)
TTS_CACHE_ENABLED=true
TTS_CACHE_MAX_ENTRIES=10000
TTS_CACHE_EVICTION_THRESHOLD=9000
TTS_CACHE_LOCAL_DIR=outputs/tts_cache

# Inference and loudness normalization (infer_fast on Windows/Linux; macOS uses infer)
TTS_USE_FAST_INFERENCE=true
TTS_NORMALIZATION_ENABLED=true
TTS_NORMALIZATION_TARGET_LUFS=-16.0

# ============================
# Forced Alignment (stable-whisper)
# ============================

# Whisper model name — "small" recommended (balance of accuracy vs CPU latency)
TTS_ALIGNMENT_MODEL=small

# Device for alignment — must be cpu; GPU is reserved for IndexTTS
# Do NOT set to "mps" on Apple Silicon (float64 crash; see STABLE_WHISPER_ALIGNMENT_PLAN.md §15)
TTS_ALIGNMENT_DEVICE=cpu

# Directory where Whisper model weights are cached (default: ~/.cache/whisper)
# Set to a persistent path in containerised deployments to avoid re-downloading on restart
# TTS_ALIGNMENT_MODEL_DIR=/opt/models/whisper

# Max alignment retries per job on transient failure
TTS_ALIGNMENT_MAX_RETRIES=2

# Alignment circuit breaker
CIRCUIT_BREAKER_ALIGNMENT_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_ALIGNMENT_RESET_TIMEOUT=60
