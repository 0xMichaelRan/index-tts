# ============================
# REQUIRED
# ============================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/indextts
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Storage bucket (voices, audio prompts — read during synthesis)
S3_STORAGE_ENDPOINT_URL=https://project.storage.supabase.co/storage/v1/s3
S3_STORAGE_ACCESS_KEY_ID=your-storage-access-key
S3_STORAGE_SECRET_ACCESS_KEY=your-storage-secret-key
S3_STORAGE_BUCKET_NAME=bucket-name
S3_STORAGE_REGION=auto
S3_STORAGE_USE_SSL=true

# Output bucket (TTS results — written after synthesis)
S3_OUTPUT_ENDPOINT_URL=https://project.storage.supabase.co/storage/v1/s3
S3_OUTPUT_ACCESS_KEY_ID=your-output-access-key
S3_OUTPUT_SECRET_ACCESS_KEY=your-output-secret-key
S3_OUTPUT_BUCKET_NAME=bucket-name
S3_OUTPUT_REGION=auto
S3_OUTPUT_USE_SSL=true

# ============================
# OPTIONAL
# ============================

# Logging (LOG_LEVEL: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/worker.log

# Circuit breaker (opens after consecutive failures; reset timeout in seconds)
CIRCUIT_BREAKER_S3_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_S3_RESET_TIMEOUT=60
CIRCUIT_BREAKER_TTS_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TTS_RESET_TIMEOUT=30

# Synthesis cache (reuse audio for same text + voice)
TTS_CACHE_ENABLED=true
TTS_CACHE_MAX_ENTRIES=10000
TTS_CACHE_EVICTION_THRESHOLD=9000
TTS_CACHE_LOCAL_DIR=outputs/tts_cache

# Inference and loudness normalization (infer_fast on Windows/Linux; macOS uses infer)
TTS_USE_FAST_INFERENCE=true
TTS_NORMALIZATION_ENABLED=true
TTS_NORMALIZATION_TARGET_LUFS=-16.0
