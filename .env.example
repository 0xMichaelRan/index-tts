# IndexTTS Worker - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Place the .env file in the project root (same directory as this file)

# ============================================================================
# RabbitMQ Configuration (Required)
# ============================================================================
# Use RABBITMQ_URL for cloud providers, or set individual parameters
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost

# Legacy individual parameters (optional, only if not using RABBITMQ_URL):
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest

# ============================================================================
# S3 Dual-Bucket Configuration (Required)
# Separate buckets for voice storage and TTS output
# ============================================================================

# Storage Bucket (for voice recordings and audio prompts)
# Read-only during synthesis - voices, audio prompts, assets
S3_STORAGE_ENDPOINT_URL=https://project.storage.supabase.co/storage/v1/s3
S3_STORAGE_ACCESS_KEY_ID=your-storage-access-key
S3_STORAGE_SECRET_ACCESS_KEY=your-storage-secret-key
S3_STORAGE_BUCKET_NAME=voice-library
S3_STORAGE_REGION=ap-southeast-1
S3_STORAGE_USE_SSL=true

# Output Bucket (for TTS synthesis results)
# Write-only during synthesis - TTS results, temporary audio
S3_OUTPUT_ENDPOINT_URL=https://project.storage.supabase.co/storage/v1/s3
S3_OUTPUT_ACCESS_KEY_ID=your-output-access-key
S3_OUTPUT_SECRET_ACCESS_KEY=your-output-secret-key
S3_OUTPUT_BUCKET_NAME=ttsoutput
S3_OUTPUT_REGION=ap-southeast-1
S3_OUTPUT_USE_SSL=true

# ============================================================================
# Queue Configuration (Optional)
# ============================================================================
TTS_QUEUE_NAME=tts_jobs
TTS_RESULT_QUEUE_NAME=tts_results

# ============================================================================
# Worker Configuration (Optional)
# ============================================================================
WORKER_PREFETCH_COUNT=1
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_SECONDS=2

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/worker.log

# ============================================================================
# Circuit Breaker Configuration (Optional)
# ============================================================================
CIRCUIT_BREAKER_S3_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_S3_RESET_TIMEOUT=60
CIRCUIT_BREAKER_TTS_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TTS_RESET_TIMEOUT=30

# ============================================================================
# Quick Start
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. Run worker: uv run worker.py
#
# Both buckets can use:
#   - Same provider (same endpoint/credentials)
#   - Different providers (different endpoints/credentials)
#   - Same provider, different regions/credentials
#
# See DUAL_BUCKET_GUIDE.md for detailed configuration examples
# Never commit .env files to version control
